DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

DB_NAME=saas_pos_db
DB_USER=pos_admin
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Payment Gateways ---

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# M-Pesa Daraja API (https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=your_mpesa_paybill_or_till_number
MPESA_PASSKEY=your_mpesa_lipa_na_mpesa_passkey_here
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/billing/webhooks/mpesa/

# Redirects after a gateway checkout completes
FRONTEND_SUCCESS_URL=http://localhost:8000/billing/success/
FRONTEND_CANCEL_URL=http://localhost:8000/billing/cancel/